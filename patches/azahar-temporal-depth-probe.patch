+bool FindDepthCandidate(PAddr color_address, DepthProvenance& candidate) {
+    bool found = false;
+    for (const auto& [base, provenance] : depth_probe.color_depth) {
+        if (color_address >= base && color_address - base < provenance.color_size) {
+            if (!found || provenance.frame > candidate.frame ||
+                (provenance.frame == candidate.frame && provenance.draw > candidate.draw) ||
+                (provenance.frame == candidate.frame && provenance.draw == candidate.draw &&
+                 (provenance.color_size < candidate.color_size ||
+                  (provenance.color_size == candidate.color_size && base < candidate.color_base)))) {
+                candidate = provenance;
+                found = true;
+            }
+        }
+    }
+    return found;
+}
+
+std::filesystem::path DepthDumpDirectory() {
+    const char* value = std::getenv("MH4U_TEMPORAL_DEPTH_DUMP");
+    if (!value || !*value) {
+        return {};
+    }
+    const std::filesystem::path path{value};
+    std::error_code error;
+    const auto canonical = std::filesystem::canonical(path, error);
+    if (!path.is_absolute() || error || canonical.string().find("/.local/") == std::string::npos ||
+        !std::filesystem::is_directory(canonical)) {
+        LOG_ERROR(Render_Vulkan,
+                  "MH4U_TEMPORAL_DEPTH_DUMP must name an existing absolute directory under .local");
+        return {};
+    }
+    return canonical;
+}
