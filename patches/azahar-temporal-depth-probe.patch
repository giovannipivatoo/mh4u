+#include "video_core/temporal_depth.h"
+
+namespace VideoCore {
+namespace {
+mh4u_temporal_depth_sink depth_sink{};
+}
+
+void SetTemporalDepthSink(const mh4u_temporal_depth_sink& sink) {
+    depth_sink = sink;
+}
+
+bool TemporalDepthEnabled() {
+    return depth_sink.abi_version == MH4U_TEMPORAL_DEPTH_ABI_VERSION &&
+           depth_sink.struct_size >= sizeof(mh4u_temporal_depth_sink) && depth_sink.enabled &&
+           depth_sink.callback && depth_sink.enabled(depth_sink.user);
+}
+
+void PublishTemporalDepth(const mh4u_temporal_depth_frame& frame) {
+    if (TemporalDepthEnabled()) {
+        depth_sink.callback(depth_sink.user, &frame);
+    }
+}
+
+} // namespace VideoCore
