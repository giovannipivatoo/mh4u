+u64 DepthProbeEnv(const char* name, u64 fallback) {
+    const char* value = std::getenv(name);
+    if (!value || !*value) {
+        return fallback;
+    }
+    char* end{};
+    const auto parsed = std::strtoull(value, &end, 10);
+    return end && *end == '\0' ? parsed : fallback;
