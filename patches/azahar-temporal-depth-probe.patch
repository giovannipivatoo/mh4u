+bool DepthProbeLogFrame() {
+    static const u64 start = DepthProbeEnv("MH4U_TEMPORAL_PROBE_START", 0);
+    static const u64 frames = DepthProbeEnv("MH4U_TEMPORAL_PROBE_FRAMES", 300);
+    return DepthProbeEnabled() && depth_probe.frame >= start && depth_probe.frame - start < frames;
