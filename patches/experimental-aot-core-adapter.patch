diff --git a/src/core/arm/aot/arm_aot.h b/src/core/arm/aot/arm_aot.h
new file mode 100644
index 0000000..d08bb0c
--- /dev/null
+++ b/src/core/arm/aot/arm_aot.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <memory>
+
+#include "aot/runtime.h"
+#include "core/arm/arm_interface.h"
+
+namespace Memory {
+class MemorySystem;
+struct PageTable;
+} // namespace Memory
+
+namespace Core {
+
+class ExclusiveMonitor;
+class System;
+
+class ARM_Aot final : public ARM_Interface {
+public:
+    ARM_Aot(System& system, Memory::MemorySystem& memory, u32 core_id,
+            std::shared_ptr<Timing::Timer> timer, ExclusiveMonitor& exclusive_monitor);
+    ~ARM_Aot() override;
+
+    void Run() override;
+    void Step() override;
+    void ClearInstructionCache() override;
+    void InvalidateCacheRange(u32 start_address, std::size_t length) override;
+    void ClearExclusiveState() override;
+    void SetPageTable(const std::shared_ptr<Memory::PageTable>& page_table) override;
+    void SetPC(u32 addr) override;
+    u32 GetPC() const override;
+    u32 GetReg(int index) const override;
+    void SetReg(int index, u32 value) override;
+    u32 GetVFPReg(int index) const override;
+    void SetVFPReg(int index, u32 value) override;
+    u32 GetVFPSystemReg(VFPSystemRegister reg) const override;
+    void SetVFPSystemReg(VFPSystemRegister reg, u32 value) override;
+    u32 GetCPSR() const override;
+    void SetCPSR(u32 cpsr) override;
+    u32 GetCP15Register(CP15Register reg) const override;
+    void SetCP15Register(CP15Register reg, u32 value) override;
+    void SaveContext(ThreadContext& ctx) override;
+    void LoadContext(const ThreadContext& ctx) override;
+    void PrepareReschedule() override;
+    bool HasSingleInstructionBreakAccuracy() override;
+
+protected:
+    std::shared_ptr<Memory::PageTable> GetPageTable() const override;
+
+private:
+    class Callbacks;
+    void Fail(const char* reason, const mh4u::aot::BlockResult* result = nullptr);
+    bool VerifyArtifactIdentity();
+    bool OverlapsCompiledCode(u32 address, unsigned bits) const;
+
+    System& system;
+    Memory::MemorySystem& memory;
+    ExclusiveMonitor& exclusive_monitor;
+    std::unique_ptr<Callbacks> callbacks;
+    mh4u::aot::GuestCpuState state{};
+    u32 cp15_thread_uprw{};
+    u32 cp15_thread_uro{};
+    std::shared_ptr<Memory::PageTable> current_page_table;
+    bool executing{};
+    bool has_run{};
+    bool identity_verified{};
+    bool reschedule_requested{};
+    bool local_exclusive_valid{};
+    u32 local_exclusive_address{};
+    u64 run_count{};
+    u64 block_count{};
+};
+
+} // namespace Core
diff --git a/src/core/arm/aot/arm_aot.cpp b/src/core/arm/aot/arm_aot.cpp
new file mode 100644
index 0000000..7a7b22a
--- /dev/null
+++ b/src/core/arm/aot/arm_aot.cpp
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "core/arm/aot/arm_aot.h"
+
+#include <algorithm>
+#include <limits>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/assert.h"
+#include "common/logging/log.h"
+#include "core/arm/exclusive_monitor.h"
+#include "core/core.h"
+#include "core/core_timing.h"
+#include "core/hle/kernel/svc.h"
+#include "core/memory.h"
+
+namespace Core {
+
+class ARM_Aot::Callbacks {
+public:
+    explicit Callbacks(ARM_Aot& parent_) : parent(parent_), svc_context(parent.system) {
+        table = {this, Read, Write, CallSvc, AddTicks, CoprocessorRead32, CoprocessorWrite32,
+                 ExclusiveRead32, ExclusiveWrite32, ClearExclusive};
+    }
+
+    mh4u::aot::Callbacks table{};
+
+private:
+    static bool ValidRange(ARM_Aot& parent, u32 address, unsigned bits) {
+        const unsigned bytes = bits / 8;
+        if ((bits != 8 && bits != 16 && bits != 32 && bits != 64) ||
+            static_cast<u64>(address) + bytes > (u64{1} << 32)) {
+            return false;
+        }
+        for (unsigned offset = 0; offset < bytes; ++offset) {
+            if (!parent.memory.GetPointer(address + offset)) return false;
+        }
+        return true;
+    }
+
+    static bool Read(void* context, u32 address, unsigned bits, u64* value) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!value || !ValidRange(self.parent, address, bits)) return false;
+        switch (bits) {
+        case 8: *value = self.parent.memory.Read8(address); return true;
+        case 16: *value = self.parent.memory.Read16(address); return true;
+        case 32: *value = self.parent.memory.Read32(address); return true;
+        case 64: *value = self.parent.memory.Read64(address); return true;
+        default: return false;
+        }
+    }
+
+    static bool Write(void* context, u32 address, unsigned bits, u64 value) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!ValidRange(self.parent, address, bits) ||
+            self.parent.OverlapsCompiledCode(address, bits)) return false;
+        switch (bits) {
+        case 8: self.parent.memory.Write8(address, static_cast<u8>(value)); return true;
+        case 16: self.parent.memory.Write16(address, static_cast<u16>(value)); return true;
+        case 32: self.parent.memory.Write32(address, static_cast<u32>(value)); return true;
+        case 64: self.parent.memory.Write64(address, value); return true;
+        default: return false;
+        }
+    }
+
+    static bool CallSvc(void* context, mh4u::aot::GuestCpuState* state, u32 number, bool* halt) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!state || state != &self.parent.state || !halt ||
+            &self.parent.system.GetRunningCore() != &self.parent) {
+            return false;
+        }
+        self.svc_context.CallSVC(number);
+        *halt = true;
+        return true;
+    }
+
+    static bool AddTicks(void* context, u64 elapsed, u64* remaining) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!remaining || elapsed > static_cast<u64>(std::numeric_limits<s64>::max())) return false;
+        if (elapsed == 0) ++self.parent.block_count;
+        self.parent.GetTimer().AddTicks(elapsed);
+        const s64 downcount = self.parent.GetTimer().GetDowncount();
+        *remaining = downcount > 0 && !self.parent.reschedule_requested
+                         ? static_cast<u64>(downcount)
+                         : 0;
+        return true;
+    }
+
+    static bool IsCp15(const u8 info[8], u8 crn, u8 crm, u8 opc2) {
+        return info && info[0] == 15 && info[1] == 0 && info[2] == 0 && info[3] == crn &&
+               info[4] == crm && info[5] == opc2 && info[6] == 0 && info[7] == 0;
+    }
+
+    static bool CoprocessorRead32(void* context, const u8 info[8], u32* value) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!value) return false;
+        if (IsCp15(info, 13, 0, 2)) *value = self.parent.cp15_thread_uprw;
+        else if (IsCp15(info, 13, 0, 3)) *value = self.parent.cp15_thread_uro;
+        else return false;
+        return true;
+    }
+
+    static bool CoprocessorWrite32(void* context, const u8 info[8], u32 value) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (IsCp15(info, 13, 0, 2)) self.parent.cp15_thread_uprw = value;
+        else if (!IsCp15(info, 7, 5, 4) && !IsCp15(info, 7, 10, 4) &&
+                 !IsCp15(info, 7, 10, 5)) return false;
+        return true;
+    }
+
+    static bool ExclusiveRead32(void* context, u32 address, u32* value) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!value || (address & 3U) != 0 || !ValidRange(self.parent, address, 32)) return false;
+        *value = self.parent.exclusive_monitor.ExclusiveRead32(self.parent.GetID(), address);
+        self.parent.local_exclusive_valid = true;
+        self.parent.local_exclusive_address = address;
+        return true;
+    }
+
+    static bool ExclusiveWrite32(void* context, u32 address, u32 value, bool* succeeded) {
+        auto& self = *static_cast<Callbacks*>(context);
+        if (!succeeded) return false;
+        const bool local_match = self.parent.local_exclusive_valid &&
+                                 self.parent.local_exclusive_address == address;
+        self.parent.local_exclusive_valid = false;
+        if (!local_match) {
+            self.parent.exclusive_monitor.ClearExclusive(self.parent.GetID());
+            *succeeded = false;
+            return true;
+        }
+        if ((address & 3U) != 0 || !ValidRange(self.parent, address, 32) ||
+            self.parent.OverlapsCompiledCode(address, 32)) return false;
+        *succeeded = self.parent.exclusive_monitor.ExclusiveWrite32(self.parent.GetID(), address,
+                                                                    value);
+        return true;
+    }
+
+    static bool ClearExclusive(void* context) {
+        auto& self = *static_cast<Callbacks*>(context);
+        self.parent.local_exclusive_valid = false;
+        self.parent.exclusive_monitor.ClearExclusive(self.parent.GetID());
+        return true;
+    }
+
+    ARM_Aot& parent;
+    Kernel::SVCContext svc_context;
+};
+
+ARM_Aot::ARM_Aot(System& system_, Memory::MemorySystem& memory_, u32 core_id,
+                 std::shared_ptr<Timing::Timer> timer, ExclusiveMonitor& exclusive_monitor_)
+    : ARM_Interface(core_id, std::move(timer)), system(system_), memory(memory_),
+      exclusive_monitor(exclusive_monitor_), callbacks(std::make_unique<Callbacks>(*this)),
+      current_page_table(memory.GetCurrentPageTable()) {}
+
+ARM_Aot::~ARM_Aot() = default;
+
+void ARM_Aot::Run() {
+    if (break_flag) return;
+    if (memory.GetCurrentPageTable() != current_page_table) {
+        Fail("active page table does not match the AOT core");
+        return;
+    }
+    if (!identity_verified && !VerifyArtifactIdentity()) return;
+    executing = true;
+    has_run = true;
+    reschedule_requested = false;
+    ++run_count;
+    const auto result = mh4u_aot_execute(&state, &callbacks->table);
+    executing = false;
+    LOG_DEBUG(Core_ARM11, "AOT run={} blocks={} exit={} pc={:08x} cpsr={:08x} fpscr={:08x}",
+              run_count, block_count, static_cast<u32>(result.exit), result.next_pc, state.cpsr,
+              state.fpscr);
+    switch (result.exit) {
+    case mh4u::aot::BlockExit::Dispatch:
+    case mh4u::aot::BlockExit::SupervisorCall:
+        return;
+    default:
+        Fail("AOT execution stopped", &result);
+        return;
+    }
+}
+
+void ARM_Aot::Step() {
+    Fail("single-instruction execution is unavailable for this AOT artifact");
+}
+
+void ARM_Aot::ClearInstructionCache() {
+    if (has_run) Fail("instruction cache clear after AOT execution began");
+}
+
+void ARM_Aot::InvalidateCacheRange(u32 start_address, std::size_t length) {
+    if (has_run && length != 0) {
+        const mh4u::aot::BlockResult result{mh4u::aot::BlockExit::CallbackFault,
+                                            state.regs[15], start_address, length};
+        Fail("code invalidation after AOT execution began", &result);
+    }
+}
+
+void ARM_Aot::ClearExclusiveState() {
+    local_exclusive_valid = false;
+    exclusive_monitor.ClearExclusive(GetID());
+}
+
+void ARM_Aot::SetPageTable(const std::shared_ptr<Memory::PageTable>& page_table) {
+    if (has_run && page_table != current_page_table) {
+        Fail("page table switch after AOT execution began");
+        return;
+    }
+    current_page_table = page_table;
+}
+
+void ARM_Aot::SetPC(u32 addr) { state.regs[15] = addr; }
+u32 ARM_Aot::GetPC() const { return state.regs[15]; }
+u32 ARM_Aot::GetReg(int index) const { return state.regs.at(static_cast<std::size_t>(index)); }
+void ARM_Aot::SetReg(int index, u32 value) { state.regs.at(static_cast<std::size_t>(index)) = value; }
+u32 ARM_Aot::GetVFPReg(int index) const { return state.ext_regs.at(static_cast<std::size_t>(index)); }
+void ARM_Aot::SetVFPReg(int index, u32 value) { state.ext_regs.at(static_cast<std::size_t>(index)) = value; }
+
+u32 ARM_Aot::GetVFPSystemReg(VFPSystemRegister reg) const {
+    if (reg == VFP_FPSCR) return state.fpscr;
+    if (reg == VFP_FPEXC) return state.fpexc;
+    UNREACHABLE_MSG("Unknown VFP system register: {}", reg);
+}
+
+void ARM_Aot::SetVFPSystemReg(VFPSystemRegister reg, u32 value) {
+    if (reg == VFP_FPSCR) state.fpscr = value;
+    else if (reg == VFP_FPEXC) state.fpexc = value;
+    else UNREACHABLE_MSG("Unknown VFP system register: {}", reg);
+}
+
+u32 ARM_Aot::GetCPSR() const { return state.cpsr; }
+void ARM_Aot::SetCPSR(u32 cpsr) { state.cpsr = cpsr; }
+
+u32 ARM_Aot::GetCP15Register(CP15Register reg) const {
+    if (reg == CP15_THREAD_UPRW) return cp15_thread_uprw;
+    if (reg == CP15_THREAD_URO) return cp15_thread_uro;
+    UNREACHABLE_MSG("Unknown CP15 register: {}", reg);
+}
+
+void ARM_Aot::SetCP15Register(CP15Register reg, u32 value) {
+    if (reg == CP15_THREAD_UPRW) cp15_thread_uprw = value;
+    else if (reg == CP15_THREAD_URO) cp15_thread_uro = value;
+    else UNREACHABLE_MSG("Unknown CP15 register: {}", reg);
+}
+
+void ARM_Aot::SaveContext(ThreadContext& ctx) {
+    ctx.cpu_registers = state.regs;
+    ctx.cpsr = state.cpsr;
+    ctx.fpu_registers = state.ext_regs;
+    ctx.fpscr = state.fpscr;
+    ctx.fpexc = state.fpexc;
+}
+
+void ARM_Aot::LoadContext(const ThreadContext& ctx) {
+    ClearExclusiveState();
+    state.regs = ctx.cpu_registers;
+    state.cpsr = ctx.cpsr;
+    state.ext_regs = ctx.fpu_registers;
+    state.fpscr = ctx.fpscr;
+    state.fpexc = ctx.fpexc;
+}
+
+void ARM_Aot::PrepareReschedule() {
+    if (executing) reschedule_requested = true;
+}
+
+bool ARM_Aot::HasSingleInstructionBreakAccuracy() { return false; }
+
+std::shared_ptr<Memory::PageTable> ARM_Aot::GetPageTable() const { return current_page_table; }
+
+bool ARM_Aot::VerifyArtifactIdentity() {
+    const mh4u::aot::ArtifactIdentity* identity = mh4u_aot_identity();
+    if (!identity || !identity->code_words || identity->code_word_count == 0 ||
+        !identity->input_sha256) {
+        Fail("AOT artifact identity is missing");
+        return false;
+    }
+    for (std::size_t index = 0; index < identity->code_word_count; ++index) {
+        const auto& expected = identity->code_words[index];
+        const auto actual = memory.Read32OrNullopt(expected.address);
+        if (!actual || *actual != expected.value) {
+            const std::string message = fmt::format(
+                "AOT code identity mismatch at {:08x}: expected {:08x}, got {}",
+                expected.address, expected.value,
+                actual ? fmt::format("{:08x}", *actual) : std::string{"unmapped"});
+            Fail(message.c_str());
+            return false;
+        }
+    }
+    identity_verified = true;
+    LOG_INFO(Core_ARM11, "AOT identity verified: {} code words, input SHA-256 {}",
+             identity->code_word_count, identity->input_sha256);
+    return true;
+}
+
+bool ARM_Aot::OverlapsCompiledCode(u32 address, unsigned bits) const {
+    const auto* identity = mh4u_aot_identity();
+    if (!identity || bits % 8 != 0) return true;
+    const u64 begin = address;
+    const u64 end = begin + bits / 8;
+    for (std::size_t index = 0; index < identity->code_word_count; ++index) {
+        const u64 code_begin = identity->code_words[index].address;
+        if (begin < code_begin + 4 && code_begin < end) return true;
+    }
+    return false;
+}
+
+void ARM_Aot::Fail(const char* reason, const mh4u::aot::BlockResult* result) {
+    std::string detail = reason;
+    if (result) {
+        detail += fmt::format(" (exit={}, pc={:08x}, detail={:08x})",
+                              static_cast<u32>(result->exit), result->next_pc, result->detail);
+    }
+    detail += fmt::format(" [cpsr={:08x}, fpscr={:08x}]", state.cpsr, state.fpscr);
+    LOG_CRITICAL(Core_ARM11, "{}", detail);
+    SetBreakFlag();
+    system.SetStatus(System::ResultStatus::ErrorCoreExceptionRaised, detail.c_str());
+}
+
+} // namespace Core
